const genre={plan:'KẾ HOẠCH: viết đầy đủ mục đích/yêu cầu, phạm vi/đối tượng, nhiệm vụ cụ thể, phân công chủ trì/phối hợp, tiến độ và sản phẩm, chế độ kiểm tra/báo cáo, tổ chức thực hiện. Mỗi yêu cầu trong công văn nguồn phải có công việc triển khai tương ứng. Chủ động đề xuất giải pháp phù hợp trường học, đơn vị chức năng và tiến độ tương đối tính từ ngày ban hành; ghi rõ các đề xuất đó trong proposals. Không chỉ chép lại chỉ đạo hoặc để trống nội dung.',report:'BÁO CÁO: viết công tác chỉ đạo, hoạt động triển khai, kết quả theo từng yêu cầu nguồn, đánh giá, tồn tại/nguyên nhân, phương hướng và kiến nghị. Chỉ dùng thì đã hoàn thành, tỷ lệ, số lượng, họp/ban hành/gỡ bỏ/thành tích khi có dữ liệu thực tế được người dùng xác nhận. Nếu chưa có số liệu thì vẫn soạn đầy đủ văn phong và cấu trúc; tập trung mô tả yêu cầu đối chiếu, phạm vi chưa xác nhận và nhận định thận trọng. Chỉ đặt ô cần điền tại số liệu thực sự bắt buộc, không thay toàn bộ các mục bằng ô trống.',dispatch:'CÔNG VĂN: không ghi tên loại CÔNG VĂN; trích yếu ngắn, kính gửi rõ, căn cứ/hoàn cảnh, nội dung đề nghị/chỉ đạo theo nhiệm vụ, đầu mối và thời hạn dự kiến phù hợp; kết thúc trang trọng.',notice:'THÔNG BÁO: viết rõ nội dung cần thông báo, đối tượng, thời gian/cách thức thực hiện và trách nhiệm. Tự soạn lời văn đầy đủ từ mục đích ngắn.',proposal:'TỜ TRÌNH: viết căn cứ, sự cần thiết, hiện trạng theo dữ kiện, nội dung đề xuất, phương án triển khai, nguồn lực dự kiến và kiến nghị cấp có thẩm quyền. Không tự tạo mức tiền cụ thể.',resolution:'NGHỊ QUYẾT ĐẢNG: viết căn cứ, đánh giá theo dữ kiện, mục tiêu, nhiệm vụ/giải pháp, trách nhiệm triển khai và kiểm tra. Không tự xác nhận cuộc họp, kết quả biểu quyết hoặc việc đã thông qua khi chưa có thông tin.',minutes:'BIÊN BẢN: soạn lời văn và các phần diễn biến/kết luận dựa trên ghi chép được cung cấp; chỉ chừa thông tin thực tế chưa có như thời gian, thành phần, ý kiến và chữ ký. Không sáng tác sự kiện đã diễn ra.',handover:'BIÊN BẢN BÀN GIAO: soạn đầy đủ bên giao/nhận, phạm vi và danh mục hồ sơ theo nguồn, tình trạng, nghĩa vụ bàn giao, tồn đọng và trách nhiệm; không tự xác nhận đã giao đủ khi thiếu kiểm kê.'};
return 'NHIỆM VỤ CHÍNH LÀ SOẠN THAY NGƯỜI DÙNG MỘT VĂN BẢN CÓ THỂ RÀ SOÁT ĐỂ TRÌNH, không yêu cầu người dùng phải viết sẵn nội dung. Yêu cầu ngắn là ý định, không mặc nhiên là trích yếu. Ví dụ “Thực hiện 100%” nghĩa mặc định là triển khai đầy đủ yêu cầu nguồn, không được dùng làm tên văn bản hoặc khẳng định đã hoàn thành 100%. Tự đặt trích yếu đúng nội dung, ngắn và chuyên nghiệp. '+(genre[template]||genre.plan)+'\nĐọc toàn bộ trang nguồn; nhận diện đầy đủ văn bản chỉ đạo, căn cứ được viện dẫn, yêu cầu, đầu mối và mốc thời gian. Căn cứ nào chỉ đọc gián tiếp trong công văn thì ghi đúng theo nguồn trong draft và nêu chưa kiểm chứng độc lập trong biên bản. Không tự phát minh căn cứ pháp lý. Có thể đề xuất nhiệm vụ, giải pháp, phân công theo chức năng và thời hạn tương đối trong văn bản triển khai; không biến đề xuất thành sự kiện đã xảy ra. Chưa có người ký, số/ngày ban hành thì để hệ thống lấy từ biểu mẫu; không đưa các dòng này vào paragraphs. Không đặt lời nhắc, cảnh báo hoặc biên bản rà soát trong thân văn bản.\nBẮT BUỘC kiểm tra căn cứ trước khi soạn: trích văn bản chỉ đạo trực tiếp và căn cứ được viện dẫn trong tất cả trang nguồn vào legal_basis, mỗi mục gồm text là câu căn cứ đầy đủ, source_id là mã tệp hoặc user và location là vị trí đọc được. Đặt các đoạn này sau trích yếu và trước mục I; không bỏ qua để đi thẳng vào MỤC ĐÍCH. Không lặp lại chúng trong paragraphs. Nếu thực sự không tìm thấy căn cứ thì trả mảng rỗng, basis_status tương ứng và giải thích trong basis_explanation, không tự bịa. Khi xác định được căn cứ phải dùng basis_status=identified và mảng không rỗng. Căn cứ văn bản hành chính được hệ thống in nghiêng. Trả draft_document: subject là trích yếu thật; paragraphs giữ từng đoạn nội dung theo role, gồm cả căn cứ; recipients là từng nơi nhận; proposals liệt kê những nội dung chủ động đề xuất để người dùng biết và duyệt. Không đưa quốc hiệu, cơ quan ban hành, số, địa danh/ngày, tên loại, chữ ký vào paragraphs. document_text là bản văn thuần tương ứng, nhưng hệ thống sẽ dựng bản Word từ draft_document, không suy đoán vị trí bằng từ khóa.\nDỮ LIỆU THỰC TẾ NGƯỜI DÙNG XÁC NHẬN: '+(confirmedFacts.trim()||'Chưa cung cấp. Tài liệu chỉ đạo không phải bằng chứng trường đã thực hiện.');
}
function outputSchema(base){return {...base,properties:{...base.properties,draft_document:schema},required:[...base.required,'draft_document']};}
function issues(d,context={}){const n=s=>String(s||'').normalize('NFD').replace(/[\u0300-\u036f]/g,'').replace(/đ/g,'d').replace(/Đ/g,'D').toUpperCase();const out=[],all=d.paragraphs.map(p=>p.text).join('\n');if(/^(THUC HIEN\s*100\s*%|LAM DAY DU|SOAN VAN BAN|CONG VAN HUONG DAN)\s*[.!]?$/i.test(n(d.subject).trim()))out.push('Trích yếu vẫn là yêu cầu ngắn, chưa nêu nội dung văn bản.');if(context.template==='plan'&&(all.length<700||d.paragraphs.filter(p=>['body','list','basis'].includes(p.role)).length<4))out.push('Dự thảo kế hoạch còn quá sơ lược; chưa triển khai đủ nội dung để rà soát trình ký.');if(context.template==='report'&&!String(context.confirmedFacts||'').trim()&&/(?:NHA TRUONG|TRUONG THPT[^\n.]{0,60})[^\n.]{0,35}(?:DA HOAN THANH|DA TO CHUC HOP|DA GO BO)|(?:DA )?HOAN THANH\s*100\s*%/.test(n(all)))out.push('Báo cáo khẳng định kết quả đã thực hiện nhưng chưa có dữ liệu thực tế xác nhận.');return out;}
const api={version:'4.1.1',schema,validate,model,instructions,outputSchema,issues};root.OfficeDrafting=api;if(typeof module!=='undefined')module.exports=api;
})(typeof globalThis!=='undefined'?globalThis:this);
